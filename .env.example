# Server-only. Never place credentials in VITE_ variables or commit .env.
MODEL_PROVIDER=vercel
AI_GATEWAY_API_KEY=
# Persistent application budget, separate from the research experiment ledger.
TOTAL_MODEL_BUDGET_USD=2
# UTC calendar day, shared across owners and visitors. AI/search pause at exhaustion.
DAILY_MODEL_BUDGET_USD=1
# Generate a private token of at least 32 characters. Never put it in VITE_ settings.
ATLAS_OWNER_TOKEN=
LEDGER_PATH=work/usage-gateway.sqlite3
MAX_RUNS_PER_DAY=100
MAX_RUNS_PER_IP_PER_HOUR=10
# The gateway implementation pins the inexpensive models/providers in gateway.py.
# Two rounds; costs are tracked on the server and never shown in the public flow.
# Optional legacy Gemini direct configuration:
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-3.5-flash-lite
# MODEL_PREPARE_NAME=gemini-3.5-flash-lite
# MODEL_API_KEY=
# MODEL_INPUT_USD_PER_MILLION=0
# MODEL_OUTPUT_USD_PER_MILLION=0
# GEMINI_FREE_TIER_ONLY=true
# GEMINI_MIN_REQUEST_INTERVAL_SECONDS=6
# GEMINI_THINKING_LEVEL=low
# MAX_OUTPUT_TOKENS=6000

# Lifetime allowance keyed by salted IP hash; suggestions do not consume it.
MAX_DEBATES_PER_IP=5

# Local default: SQLite. Cloud Run requires Firestore and an attached service account.
LEDGER_BACKEND=sqlite
# Set only after verifying the ingress chain on the chosen host. Uvicorn proxy parsing must be off.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=

# Optional managed email/password signup and private account history.
# This is a PUBLIC Firebase client API key, never the AI Gateway secret.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

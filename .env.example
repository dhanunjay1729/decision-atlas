# Server-only. Never place credentials in VITE_ variables or commit .env.
MODEL_PROVIDER=vercel
AI_GATEWAY_API_KEY=
# Persistent application budget, separate from the research experiment ledger.
TOTAL_MODEL_BUDGET_USD=2
LEDGER_PATH=work/usage-gateway.sqlite3
MAX_RUNS_PER_DAY=100
MAX_RUNS_PER_IP_PER_HOUR=3
# The gateway implementation pins the inexpensive models/providers in gateway.py.
# Two rounds; expected costs shown before execution are estimates, not guarantees.
# Optional legacy Gemini direct configuration:
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-3.5-flash-lite
# MODEL_PREPARE_NAME=gemini-3.5-flash-lite
# MODEL_API_KEY=
# MODEL_INPUT_USD_PER_MILLION=0
# MODEL_OUTPUT_USD_PER_MILLION=0
# GEMINI_FREE_TIER_ONLY=true
# GEMINI_MIN_REQUEST_INTERVAL_SECONDS=6
# GEMINI_THINKING_LEVEL=low
# MAX_OUTPUT_TOKENS=6000

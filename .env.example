# Server-side settings only. Never place secrets in VITE_ variables.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.5-flash-lite
MODEL_PREPARE_NAME=gemini-3.5-flash-lite
MODEL_API_KEY=
# For OpenAI-compatible endpoints; omit for Gemini direct.
MODEL_BASE_URL=
# Application upper bounds, enforced server-side.
MAX_RUNS_PER_DAY=100
MAX_RUNS_PER_IP_PER_HOUR=3
MAX_OUTPUT_TOKENS=6000
GEMINI_THINKING_LEVEL=low
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=6
GEMINI_FREE_TIER_ONLY=true
TOTAL_MODEL_BUDGET_USD=3
# Explicitly set these from the selected provider's current price sheet.
# Use 0 for genuinely free endpoints. Include reasoning-token pricing where applicable.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Live web retrieval is not connected in this first increment.
